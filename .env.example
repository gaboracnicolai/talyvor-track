# Talyvor Track — environment template.
# Copy to .env and fill in. docker compose reads values automatically.

# ─── REQUIRED — Track refuses to start without these ──────
TRACK_DATABASE_URL=postgres://track:CHANGE_ME@localhost:5432/talyvor_track?sslmode=disable

# Track's copy of the edge gateway's transit-proof secret, >= 16 chars.
#
# ⚠ THIS IS THE ROOT OF THE AUTH BOUNDARY. Track trusts the gateway-injected identity
#   headers (x-user-email etc.) on any request that presents this value. Whoever knows it
#   can act as ANY user in ANY workspace. It has no default and never should: compose
#   refuses to render the stack when it is unset, and gatewayauth.Middleware panics at
#   boot below the minimum length.
#
#   Generate a fresh one PER ENVIRONMENT and never share it between them:
#       openssl rand -hex 32
#   It must match the edge gateway's GATEWAY_AUTH_SECRET exactly — rotating means
#   updating BOTH sides together.
GATEWAY_AUTH_SECRET=

# ─── Core ──────────────────────────────────────────────────
TRACK_REDIS_URL=redis://localhost:6379
TRACK_LOG_LEVEL=info

# ─── High availability (optional) ─────────────────────────
# OFF by default — a single Track instance behaves exactly as before and never
# touches Redis. Set to true ONLY when running 2+ instances behind a load
# balancer: the realtime hub then fans out live events across instances via
# Redis pub/sub (TRACK_REDIS_URL), so an event raised on one instance reaches
# clients connected to another. A Redis blip degrades to local-only delivery.
TRACK_HA_ENABLED=false

# Compose-only — sets the Postgres password for the bundled postgres service and is
# interpolated into TRACK_DATABASE_URL. REQUIRED, and blank here for the same reason as the
# gateway secret: compose declares it `${POSTGRES_PASSWORD:?…}`, so `docker compose up`
# refuses rather than silently starting with a committed credential. It previously
# defaulted to `changeme` in three places.
#   openssl rand -hex 16
POSTGRES_PASSWORD=

# ─── Talyvor Lens integration (optional but recommended) ──
# When set, Track surfaces per-issue AI cost in the UI and via MCP.
TRACK_LENS_URL=http://localhost:8080
# A Lens WORKSPACE key (tlv_...). Reads per-issue spend. It CANNOT mint, so it does not enable AI.
TRACK_LENS_API_KEY=
# The value of Lens's LENS_MINT_KEY. Required for every AI feature (triage, duplicates, summary,
# sprint suggestions, semantic search) — they mint a per-workspace token, which a tlv_ key cannot do.
# ⚠ NEVER set this to Lens's LENS_API_KEY: that global admin key would work and would give a Track
# compromise Lens admin over every tenant. Unset ⇒ AI features say they are not configured.
TRACK_LENS_MINT_KEY=
TRACK_LENS_WEBHOOK_SECRET=
# Where the AI-cost API links a human to see request-level spend (emitted as `lens_url`).
# OPTIONAL — unset means no link is emitted. Point it at whatever actually serves a cost UI
# for this deployment (usually the Talyvor suite app). Do NOT point it at TRACK_LENS_URL +
# /dashboard: that Lens route is off by default and its flag is not forwarded by Lens's
# compose, so it 404s. Track no longer derives this — it links only where you say.
TRACK_LENS_DASHBOARD_URL=

# ─── GitHub integration (optional) ────────────────────────
# Receives PR-merged / PR-opened webhooks at /v1/webhooks/github.
# Sign your webhook secret here and in the repo settings → Webhooks.
TRACK_GITHUB_WEBHOOK_SECRET=

# The workspace this GitHub org's webhooks may act on. REQUIRED for the webhook to take
# any issue action: PR references ("Closes ENG-42") are unique per workspace only, and
# this one secret authenticates every delivery with no tenant signal of its own — so
# without an explicit scope the handler would have to guess which tenant to write to.
# Unset ⇒ deliveries are authenticated and acknowledged but change nothing (fail-closed).
# A multi-tenant deployment needs per-workspace webhook secrets; that is not built yet.
TRACK_GITHUB_WEBHOOK_WORKSPACE_ID=

# ─── Guest access (optional, but read the first one) ──────
# Seeds the HMAC key that signs stateless guest access tokens.
#
# ⚠ UNSET IS NOT "OFF" — IT IS A DIFFERENT SECRET ON EVERY PROCESS. guest.newStore
#   silently generates a random 32-byte key when this is empty. Measured: a token
#   signed by one process is rejected by another with "guest: signature mismatch".
#   So on a deployment that leaves this blank, EVERY outstanding guest link stops
#   working at each restart, and with 2+ instances behind a load balancer guest
#   access fails intermittently depending on which instance answers — with no error
#   at boot and no log line. Fine for local dev; set it anywhere else.
#       openssl rand -hex 32
TRACK_GUEST_SECRET=

# Base URL that invite links are built from (the /invite/<token> page the guest opens).
# Unset ⇒ http://localhost:5173, which is a DEV default that will happily go out in a
# production invite. Point it at wherever the front end actually serves.
TRACK_INVITE_BASE_URL=

# ─── Member sync (optional) ───────────────────────────────
# Bearer token for GET /v1/service/members, constant-time compared. Unset ⇒ that endpoint
# 401s everything and member-sync is off. If set it must be >= 16 chars or Track refuses
# to boot.
#
# ⚠ THIS ONE TOKEN GATES EVERY TENANT'S MEMBER ROSTER — a valid holder can read any
#   workspace's members. Treat it as top-tier: a DEDICATED secret, never reused, only in
#   the member-sync consumer's server-side environment (never browser-reachable).
#   Rotating means updating Track AND the consumer together. Every pull is audit-logged
#   (event=service_member_pull).
#       openssl rand -hex 32
TRACK_MEMBER_SYNC_SECRET=

# ─── Workspace integrations (optional) ────────────────────
# AES-256-GCM key encrypting per-workspace provider API tokens (Linear/Jira) at rest.
# Base64, decoding to EXACTLY 32 bytes — a wrong length or non-base64 value fails at boot,
# loudly, rather than surfacing as broken crypto later. Unset ⇒ the integration store is
# disabled and live API import is unavailable; Track still runs.
#       openssl rand -base64 32
TRACK_INTEGRATION_ENCRYPTION_KEY=

# ─── Tuning (optional — each shows its default) ───────────
# Address the HTTP server binds. Default 0.0.0.0:3000.
TRACK_LISTEN_ADDR=0.0.0.0:3000
# Max age of a Lens spend alert's signed emitted_at before the webhook rejects it as a
# replay. Go duration; default 5m; <=0 disables the check.
TRACK_LENS_WEBHOOK_FRESHNESS=5m
